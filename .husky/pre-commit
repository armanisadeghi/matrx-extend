# OUTBOUND REFERRAL (Arman, 2026-10-12: "make sure it never happens again"): a staged src file may not
# add a raw link to a third-party site (<a target="_blank">, literal https:// anchor, window.open,
# chrome.tabs.create without withReferral, literal location.href) outside @ai-matrx/kit/outbound. ~1 s.
OUTBOUND="node_modules/@ai-matrx/kit/scripts/check-outbound-referral.mjs"
STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- 'src/*.ts' 'src/*.tsx' || true)
if [ -f "$OUTBOUND" ] && [ -n "$STAGED" ]; then
    # shellcheck disable=SC2086
    node "$OUTBOUND" $STAGED || {
        echo "COMMIT REFUSED: a raw outbound link (above) skips our referral data." >&2
        echo "  Fix: node $OUTBOUND --fix <file>, then stage and commit again." >&2
        exit 1
    }
fi

# THE LINE ICON (Arman, 2026-10-24): a leading icon is never nudged down by hand (mt-0.5 h-3.5 w-3.5
# shrink-0); it uses matrx-line-icon*, centered on the first text line (@ai-matrx/design-system line-icon.css).
LINE_ICONS="node_modules/@ai-matrx/design-system/scripts/check-line-icons.mjs"
ICON_STAGED=$(git diff --cached --name-only --diff-filter=ACMR -- 'src/*.tsx' | grep -v '\.test\.' || true)
if [ ! -f "$LINE_ICONS" ] && [ -n "$ICON_STAGED" ]; then
    echo "line-icons guard NOT RUN: the installed @ai-matrx/design-system predates check-line-icons.mjs (run pnpm sync:matrx-packages once it is published)." >&2
fi
if [ -f "$LINE_ICONS" ] && [ -n "$ICON_STAGED" ]; then
    # shellcheck disable=SC2086
    node "$LINE_ICONS" $ICON_STAGED || {
        echo "COMMIT REFUSED: an icon is nudged down by hand (above)." >&2
        exit 1
    }
fi
