+it('reports preparation and refuses late approval after cancellation of a pending pattern read', async () => {
+  let release!: () => void;
+  h.prepGate = new Promise<void>((resolve) => { release = resolve; });
+  const dispatch = await import('@/lib/tools/dispatch');
+  dispatch.startToolDispatcher({ defaultPermissionMode: () => 'act' });
+  const controller = new AbortController();
+  const progress = vi.fn();
+  const result = dispatch.runLocalSavedPattern(
+    'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa', 37, controller.signal, progress,
+  );
+  await vi.waitFor(() =>
+    expect(progress).toHaveBeenCalledWith('Checking saved recipe and page…'),
+  );
+  expect(h.broadcasts.mock.calls.some(
+    ([kind]) => kind === CHANNELS.TOOL_CONFIRM_REQUEST,
+  )).toBe(false);
+  controller.abort();
+  release();
+  await expect(result).rejects.toThrow('cancelled');
+  expect(h.broadcasts.mock.calls.some(
+    ([kind]) => kind === CHANNELS.TOOL_CONFIRM_REQUEST,
+  )).toBe(false);
+  expect(h.run).not.toHaveBeenCalled();
+});
