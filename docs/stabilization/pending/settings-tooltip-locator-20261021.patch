+// Removing tooltip-label fallback must make the lifted-label case fail:
+// run the real driver expression against actual DOM selector matching.
+for (const lifted of [false, true]) {
+  test(`replacement Settings readiness resolves ${lifted ? 'lifted' : 'native'} tooltip label`, async () => {
+    const window = new Window();
+    try {
+      window.document.body.innerHTML =
+        '<div id="app"><button role="tab" title="Settings"></button></div>';
+      const tab = window.document.querySelector('button');
+      if (lifted) {
+        tab.setAttribute('data-matrx-title', tab.getAttribute('title'));
+        tab.removeAttribute('title');
+      }
+      tab.getBoundingClientRect = () => ({ width: 28, height: 28 });
+      const panel = {
+        async send(method, args) {
+          assert.equal(method, 'Runtime.evaluate');
+          return { result: { value: window.eval(args.expression) } };
+        },
+      };
+      const receipt = await waitForReplacementSettingsTab(panel, 120);
+      assert.equal(receipt.last.matched, 1);
+      assert.equal(receipt.last.visible, 1);
+    } finally {
+      await window.happyDOM.abort();
+    }
+  });
+}
