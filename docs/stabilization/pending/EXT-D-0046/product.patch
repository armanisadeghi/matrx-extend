+/**
+ * A path stays dotted while each key is unambiguous. Keys containing path
+ * punctuation use a JSON-quoted bracket segment (for example, ["feeds.news"]).
+ * Existing dotted recipes retain their original segment meaning.
+ */
+export function appendJsonKeyPath(parent: string, key: string): string {
+  if (!key || /[.[\]\\]/.test(key)) return `${parent}[${JSON.stringify(key)}]`;
+  return parent ? `${parent}.${key}` : key;
+}
+
+export function parseJsonKeyPath(path: string): string[] {
+  if (!path) return [];
+  const parts: string[] = [];
+  let index = 0;
+  while (index < path.length) {
+    if (path[index] === '.') {
+      index++;
+      continue;
+    }
+    if (path.startsWith('["', index)) {
+      // JSON.parse owns string escapes; scan only to find its closing quote.
+      const start = index + 1;
+      let end = start + 1;
+      let escaped = false;
+      while (end < path.length) {
+        const char = path[end];
+        if (!escaped && char === '"') break;
+        if (!escaped && char === '\\') escaped = true;
+        else escaped = false;
+        end++;
+      }
+      if (path[end] !== '"' || path[end + 1] !== ']') return path.split('.').filter(Boolean);
+      try {
+        const part: unknown = JSON.parse(path.slice(start, end + 1));
+        if (typeof part !== 'string') return path.split('.').filter(Boolean);
+        parts.push(part);
+      } catch {
+        return path.split('.').filter(Boolean);
+      }
+      index = end + 2;
+      if (index < path.length && path[index] !== '.' && !path.startsWith('["', index)) {
+        return path.split('.').filter(Boolean);
+      }
+      continue;
+    }
+    const start = index;
+    while (index < path.length && path[index] !== '.' && !path.startsWith('["', index)) index++;
+    parts.push(path.slice(start, index));
+  }
+  return parts;
+}
+
+export function resolveJsonKeyPath(value: unknown, path: string): unknown {
+  let target = value;
+  for (const part of parseJsonKeyPath(path)) {
+    if (target == null || typeof target !== 'object') return undefined;
+    target = (target as Record<string, unknown>)[part];
+  }
+  return target;
+}
