+test('Settings controls routes owned and host startup CPU brackets through the guarded guest step', async () => {
+  const workflow = await readFile(
+    new URL('../.github/workflows/hosted-guest-acceptance.yml', import.meta.url),
+    'utf8',
+  );
+  const step = workflow
+    .split('      - name: Exercise the selected Chrome side-panel case\n')[1]
+    ?.split('      - name: ')[0];
+  assert.ok(step, 'guarded guest step missing');
+  assert.match(step, /node scripts\/stabilization-resource\.mjs run --run-id "hosted-guest-/);
+  const expression = step.match(/MATRX_STARTUP_INTERVAL_DIAGNOSTIC: \$\{\{ (.+) \}\}/)?.[1];
+  assert.ok(expression, 'startup bracket route missing');
+  const enabled = (acceptance_case, seo_diagnostic = 'none') =>
+    Function('inputs', `return ${expression}`)({ acceptance_case, seo_diagnostic });
+  assert.equal(enabled('settings-controls'), '1');
+  assert.equal(enabled('guest-chat'), '1');
+  assert.equal(enabled('member-chat'), '1');
+  assert.equal(enabled('guest-seo', 'resource'), '1');
+  assert.equal(enabled('settings-theme-rendering'), '0');
+  assert.equal(enabled('guest-seo'), '0');
+});
