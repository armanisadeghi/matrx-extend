    "exact_query": "WITH relevant_definitions AS (\n  SELECT id, name, tier, category, admin_only, is_active\n  FROM tool.definition\n  WHERE name IN ('list_chrome_categories','list_core_tools','list_reading_tools','list_interaction_tools','list_tabs_tools','list_capture_tools','list_chrome_tools','list_human_tools','list_memory_tools','list_ai_tools','list_demos_tools','list_guidance_tools','list_devtools_tools','list_webmcp_tools','list_desktop_tools','list_credentials_tools','list_crm_tools','list_education_tools','list_productivity_tools','list_records_tools','chrome_batch','read_page','find','get_page_text','get_active_tab','get_page_selection','read_active_page','take_screenshot','query_elements','find_text_on_page','get_page_links','get_computed_style','get_element_at_point','inspect_element','get_element_details','list_open_tabs','get_tab_groups','get_tab_info','search_bookmarks','list_bookmark_tree','search_history','list_recent_history','list_downloads','get_form_fields','ai_check_availability','ai_summarize','ai_classify','ai_extract_json','ai_translate','ai_detect_language','ai_proofread','ai_describe_image','ai_check_prompt_injection','navigate_active_tab','click_element','type_into_element','scroll_page','wait_for','set_clipboard','sleep','press_keys','hover_element','focus_element','blur_element','right_click_element','select_dropdown_option','set_checkbox','set_radio','submit_form','file_upload','open_new_tab','close_tab','switch_to_tab','duplicate_tab','pin_tab','mute_tab','reload_tab','go_back','go_forward','set_tab_zoom','move_tab','resize_window','create_tab_group','add_tabs_to_group','remove_tabs_from_group','update_tab_group','download_url','cancel_download','credential_login','capture_prospect','capture_study_set','google_email_send','remember_for_domain','list_recently_closed','restore_recently_closed','chrome_save_page_as_mhtml','get_cookies','set_cookie','delete_cookie','cdp_attach','cdp_detach','cdp_attached_tabs','cdp_full_page_screenshot','cdp_a11y_tree','cdp_input_click_xy','cdp_input_type','cdp_network_capture_start','cdp_network_capture_drain','cdp_network_capture_stop','cdp_network_get_body','cdp_print_pdf','cdp_perf_metrics','cdp_emulate_device','cdp_clear_emulation','read_console_messages','read_network_requests','get_request_body','webmcp_check_availability','webmcp_list_page_tools','webmcp_call_page_tool','user','request_user_takeover','update_plan','user_todos','inject_stylesheet','remove_stylesheet','desktop_run_command','parallel_for_each_tab','chrome_record_gif','records','chrome_record_tab_video','record_demo','list_demos','describe_demo','replay_demo','delete_demo','save_guidance_note','list_guidance','get_guidance_item','delete_guidance_item','list_highlights','extract_table','screenshot_region','get_clipboard','chrome_tab_audio_inspect','mutation_watch','extract_microdata','data_patterns','fetch_url_as_markdown','computer','form_input','navigate','tabs','downloads','clipboard','upload_file','drop_file','read_pdf','ai','chrome_cookies','chrome_webmcp','tab_groups','chrome_bookmarks','chrome_history','chrome_recently_closed','stylesheet','cdp_session','cdp_emulate')\n     OR id IN (SELECT tool_id FROM tool.binding WHERE executor_name = 'chrome-extension')\n),\nbindings AS (\n  SELECT tool_id, executor_name, is_active\n  FROM tool.binding\n  WHERE executor_name = 'chrome-extension'\n),\nsurfaces AS (\n  SELECT surface_name, always_include_tools, always_include_bundles, never_include_tools\n  FROM tool.surface_defaults\n  WHERE surface_name IN ('chrome-extension/assistant', 'chrome-extension/pilot')\n)\nSELECT jsonb_build_object(\n  'definitions', (SELECT jsonb_agg(to_jsonb(d) ORDER BY d.name, d.id) FROM relevant_definitions d),\n  'bindings', (SELECT jsonb_agg(to_jsonb(b) ORDER BY b.executor_name, b.tool_id) FROM bindings b),\n  'surfaces', (SELECT jsonb_agg(to_jsonb(s) ORDER BY s.surface_name) FROM surfaces s)\n) AS census;"
