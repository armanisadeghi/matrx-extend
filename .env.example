# Copy to .env.development.local / .env.production.local etc., or set in CI.

# Supabase (publishable key — sb_publishable_* format, safe to ship)
WXT_SUPABASE_URL=https://db.matrxserver.com
WXT_SUPABASE_PUBLISHABLE_KEY=sb_publishable_4pvkRT-9-_dB0PWqF1sp1w_W9leRIoW

# OAuth client registered for the Chrome extension (public PKCE)
# Create a new client in the Supabase dashboard with redirect:
# https://<EXTENSION_ID>.chromiumapp.org/
WXT_EXTENSION_OAUTH_CLIENT_ID=

# NOTE: Backend URL is NOT configured here. It always defaults to production
# at runtime. Admins can switch to staging / dev / local via Settings, which
# writes to chrome.storage.local — see src/config/backend.ts.

# Desktop bridge: matrx-local localhost proxy
WXT_DESKTOP_LOCAL_URL=http://127.0.0.1:22180
WXT_DESKTOP_NATIVE_HOST=com.matrx.local
