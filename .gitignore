# Dependencies
node_modules/
.pnpm-store/
/.pnp
.pnp.js

# Build output
.output/
.wxt/
dist/
build/
/build
*.tsbuildinfo

# Generated
types/python-generated/
!types/python-generated/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env (committed: .env.development, .env.production, .env.example; ignored: local overrides)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test artifacts
coverage/
/coverage
playwright-report/
test-results/

# Python lib/ rule (carried from monorepo conventions). MUST allow our src/lib.
lib/
lib64/
!src/lib/
!src/lib/**

# Extension secrets — private key never leaves the machine.
.secrets/
*.pem
*.crx
*.spki.der
