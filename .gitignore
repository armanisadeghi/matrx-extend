# Dependencies
node_modules/
.pnpm-store/
/.pnp
.pnp.js

# Build output
.output/
.wxt/
dist/
build/
/build
*.tsbuildinfo

# Generated — but stream-events.ts is checked in as a vendored fallback so a
# clean checkout (and CI) can typecheck + build without the aidream sibling.
# `pnpm update-api-types` regenerates it; commit the diff when it changes.
# NOTE: use `dir/*` (not `dir/`) so the un-ignore exceptions below can work —
# git cannot re-include files inside a fully-ignored directory.
types/python-generated/*
!types/python-generated/.gitkeep
!types/python-generated/stream-events.ts

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Env (committed: .env.development, .env.production, .env.example; ignored: local overrides)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test artifacts
coverage/
/coverage
playwright-report/
test-results/

# Python lib/ rule (carried from monorepo conventions). MUST allow our src/lib.
lib/
lib64/
!src/lib/
!src/lib/**

# Extension secrets — private key never leaves the machine.
.secrets/
*.pem
*.crx
*.spki.der

# Claude Code worktrees (ephemeral, created by /worktree)
.claude/worktrees/


# Arman Specific
.arman-temp/

# Redacted, local-only receipts from the deliberate real-browser Vault canary.
# The runner writes here so reconnects and /tmp cleanup cannot erase evidence.
.matrx/realbrowser-vault/

# macOS Finder metadata
.DS_Store
**/.DS_Store

# The mandate reference check (`check:mandate-references`) writes its module
# index cache here. It must never make the working tree dirty: a dirty tree is
# reported UNMEASURED with an `incomplete` verdict, which would mean the check
# spoiled its own report just by running.
.cache/

# Local Vault browser artifacts and receipts; source harness lives in tests/browser.
.matrx/task1-active/

# Python bytecode from the vault canary test helpers
__pycache__/
*.pyc
