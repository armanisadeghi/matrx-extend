{
  "name": "matrx-extend",
  "version": "0.2.12",
  "private": true,
  "type": "module",
  "description": "AI assistant for understanding and working with the page open in your browser.",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "prebuild": "tsc --noEmit && tsx scripts/check-canonical-pickers.ts && tsx scripts/check-archived-items-law.ts && (tsx scripts/check-tool-db-drift.ts || true)",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "prezip": "tsc --noEmit && tsx scripts/check-canonical-pickers.ts && tsx scripts/check-archived-items-law.ts && (tsx scripts/check-tool-db-drift.ts || true)",
    "zip": "wxt zip",
    "zip:store": "pnpm prezip && MATRX_CWS_BUILD=1 wxt zip && node scripts/check-store-package.mjs && node scripts/check-cws-release-risk.mjs",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "update-api-types": "node scripts/update-api-types.mjs",
    "update-api-types:local": "node scripts/update-api-types.mjs --local",
    "catalog:tools": "tsx scripts/dump-tool-catalog.ts",
    "catalog:tools:md": "tsx scripts/dump-tool-catalog.ts --markdown",
    "catalog:tools:drift": "tsx scripts/check-tool-db-drift.ts",
    "catalog:tools:drift:strict": "tsx scripts/check-tool-db-drift.ts --strict",
    "catalog:tools:db-dump": "node scripts/dump-tool-db-to-md.mjs",
    "docs:tools": "tsx scripts/dump-tools-from-db.ts",
    "check:migrations": "tsx scripts/check-migrations.ts",
    "check:migrations:strict": "tsx scripts/check-migrations.ts --strict",
    "ui:add": "pnpm dlx shadcn@latest add",
    "prepare": "wxt prepare && husky || true",
    "check:schema-routing": "tsx scripts/check-schema-routing.ts",
    "check:schema-routing:strict": "tsx scripts/check-schema-routing.ts --strict",
    "check:docs-pointers": "tsx scripts/check-docs-pointers.ts",
    "check:docs-pointers:strict": "tsx scripts/check-docs-pointers.ts --strict",
    "check:cws-risk": "node scripts/check-cws-release-risk.mjs",
    "check:matrx-packages": "node scripts/check-matrx-packages.mjs",
    "check:matrx-latest": "node scripts/check-matrx-packages.mjs",
    "sync:matrx-packages": "pnpm update -r \"@ai-matrx/*\" --latest && pnpm check:matrx-packages",
    "check:package-twins": "node scripts/check-package-twins.mjs --strict",
    "check:package-twins:self-test": "node scripts/check-package-twins.mjs --self-test",
    "check:archived-items-law": "tsx scripts/check-archived-items-law.ts",
    "check:archived-items-law:self-test": "tsx scripts/check-archived-items-law.ts --self-test",
    "check:canonical-pickers": "tsx scripts/check-canonical-pickers.ts",
    "check:canonical-pickers:self-test": "tsx scripts/check-canonical-pickers.ts --self-test"
  },
  "dependencies": {
    "@ai-matrx/agents": "latest",
    "@ai-matrx/content-ir": "latest",
    "@ai-matrx/content-ir-react": "latest",
    "@ai-matrx/design-system": "latest",
    "@ai-matrx/kit": "latest",
    "@ai-matrx/realtime": "latest",
    "@ai-matrx/tap-target": "latest",
    "@cartesia/cartesia-js": "^2.2.9",
    "@hookform/resolvers": "^3.10.0",
    "@joplin/turndown-plugin-gfm": "^1.0.61",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-avatar": "^1.1.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.6",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.7",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.4",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/query-async-storage-persister": "^5.100.5",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-query-persist-client": "^5.100.5",
    "@webext-core/messaging": "^2.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "defuddle": "^0.6.0",
    "dompurify": "^3.4.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.55.0",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "tailwind-merge": "^2.6.0",
    "tldraw": "^4.5.10",
    "turndown": "^7.2.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/vite": "^4.2.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/chrome": "^0.0.295",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "^5.0.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@wxt-dev/module-react": "^1.1.5",
    "happy-dom": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.0",
    "openapi-typescript": "^7.6.0",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^2.1.0",
    "wxt": "^0.20.17"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": "biome check --write --no-errors-on-unmatched"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "spawn-sync"
    ]
  }
}
