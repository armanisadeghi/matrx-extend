{
  "name": "matrx-extend",
  "version": "0.1.12",
  "private": true,
  "type": "module",
  "description": "Matrx Extend — agentic Chrome extension for chat, tasks, scraping, structured data extraction, and SEO",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "update-api-types": "node scripts/update-api-types.mjs",
    "update-api-types:local": "node scripts/update-api-types.mjs --local",
    "catalog:tools": "tsx scripts/dump-tool-catalog.ts",
    "catalog:tools:md": "tsx scripts/dump-tool-catalog.ts --markdown",
    "ui:add": "pnpm dlx shadcn@latest add",
    "prepare": "wxt prepare && husky || true"
  },
  "dependencies": {
    "@cartesia/cartesia-js": "^2.2.9",
    "@hookform/resolvers": "^3.10.0",
    "@joplin/turndown-plugin-gfm": "^1.0.61",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-avatar": "^1.1.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-scroll-area": "^1.2.6",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.7",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.4",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/query-async-storage-persister": "^5.100.5",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-query-persist-client": "^5.100.5",
    "@webext-core/messaging": "^2.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "defuddle": "^0.6.0",
    "dompurify": "^3.4.0",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.55.0",
    "react-markdown": "^9.0.3",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.0.2",
    "tailwind-merge": "^2.6.0",
    "tldraw": "^4.5.10",
    "turndown": "^7.2.0",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/chrome": "^0.0.295",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/turndown": "^5.0.5",
    "@wxt-dev/module-react": "^1.1.5",
    "happy-dom": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.0",
    "openapi-typescript": "^7.6.0",
    "tailwindcss": "^4.2.0",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vitest": "^2.1.0",
    "wxt": "^0.20.17"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": "biome check --write --no-errors-on-unmatched"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild",
      "spawn-sync"
    ]
  }
}
